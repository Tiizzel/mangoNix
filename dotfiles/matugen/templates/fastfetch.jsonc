{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "{{colors.primary.default.hex}}",
      "2": "{{colors.tertiary.default.hex}}",
      "3": "{{colors.primary.default.hex}}",
      "4": "{{colors.tertiary.default.hex}}",
      "5": "{{colors.primary.default.hex}}",
      "6": "{{colors.tertiary.default.hex}}"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "{{colors.primary.default.hex}}",
      "title": "{{colors.tertiary.default.hex}}"
    },
    "percent": {
      "color": {
        "green": "#88d8b0",
        "yellow": "#f6c177",
        "red": "{{colors.error.default.hex}}"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{#title} {user-name}{#keys}@{host-name}"
    },
    {
      "type": "custom",
      "format": "{#keys}╭─ {#title}󰣚 System & Identity {#keys}───────────────────────────╮"
    },
    {
      "type": "os",
      "key": "{#keys}│ {#keys}󰅐 Distro     {#keys}│",
      "format": "{name} ({codename})"
    },
    {
      "type": "kernel",
      "key": "{#keys}│ {#keys} Kernel     {#keys}│"
    },
    {
      "type": "uptime",
      "key": "{#keys}│ {#keys}󱦟 Uptime     {#keys}│"
    },
    {
      "type": "packages",
      "key": "{#keys}│ {#keys}󰏖 Packages   {#keys}│"
    },
    {
      "type": "custom",
      "format": "{#keys}├─ {#title}󱂬 Desktop & Workspace {#keys}─────────────────────────┤"
    },
    {
      "type": "wm",
      "key": "{#keys}│ {#keys} Compositor {#keys}│"
    },
    {
      "type": "terminal",
      "key": "{#keys}│ {#keys}󰞕 Terminal   {#keys}│"
    },
    {
      "type": "display",
      "key": "{#keys}│ {#keys}󰍹 Display    {#keys}│"
    },
    {
      "type": "custom",
      "format": "{#keys}├─ {#title}󰍛 Hardware & Telemetry {#keys}────────────────────────┤"
    },
    {
      "type": "cpu",
      "key": "{#keys}│ {#keys}󰍛 Processor  {#keys}│",
      "temp": true
    },
    {
      "type": "gpu",
      "key": "{#keys}│ {#keys}󰢮 Graphics   {#keys}│",
      "temp": true
    },
    {
      "type": "memory",
      "key": "{#keys}│ {#keys} Memory     {#keys}│",
      "percent": {
        "type": 11
      }
    },
    {
      "type": "disk",
      "key": "{#keys}│ {#keys}󰋊 NVMe Root  {#keys}│",
      "folders": "/",
      "percent": {
        "type": 11
      }
    },
    {
      "type": "disk",
      "key": "{#keys}│ {#keys}󰋊 NVMe Games {#keys}│",
      "folders": "/mnt/games",
      "percent": {
        "type": 11
      }
    },
    {
      "type": "custom",
      "format": "{#keys}╰─────────────────────────────────────────────────╯"
    },
    {
      "type": "custom",
      "format": "{#31}󰮯 {#33}󰊠 {#32}󰊠 {#36}󰊠 {#34}󰊠 {#35}󰊠 {#37}󰊠"
    }
  ]
}
