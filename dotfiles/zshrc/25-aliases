# -----------------------------------------------------
# ALIASES
# -----------------------------------------------------

alias asdf='journalctl -t tclient | fzf --no-sort'
alias gemini='agy'

# -----------------------------------------------------
# General
# -----------------------------------------------------
alias ..='cd ..'
alias c='clear'
alias nf='fastfetch'
alias pf='fastfetch'
alias ff='fastfetch'
alias ls='eza -a --icons=always'
alias ll='eza -al --icons=always'
alias lt='eza -a --tree --level=1 --icons=always'
alias shutdown='systemctl poweroff'
alias v='$EDITOR'
alias vim='$EDITOR'
alias wifi='nmtui'
alias apps='quickshell ipc -c nixHypr-shell call main handleCommand toggle applauncher ""'
alias screenshot='~/.config/hypr/scripts/screenshot.sh'
alias updates='nh os switch --update'
alias filemanager='thunar'
alias lock='hyprlock'
alias clock='tty-clock'
alias system='btop'
alias wallpaper='quickshell ipc -c nixHypr-shell call main handleCommand toggle wallpaper ""'
alias settings='quickshell ipc -c nixHypr-shell call main handleCommand toggle settings ""'

# -----------------------------------------------------
# NixOS System Management
# -----------------------------------------------------

# -----------------------------------------------------
# Git
# -----------------------------------------------------
alias gs="git status"
alias ga="git add"
alias gc="git commit -m"
alias gp="git push"
alias gpl="git pull"
alias gst="git stash"
alias gsp="git stash; git pull"
alias gfo="git fetch origin"
alias gcheck="git checkout"
alias gcredential="git config credential.helper store"


# -----------------------------------------------------
# System
# -----------------------------------------------------
alias update-grub='sudo grub-mkconfig -o /boot/grub/grub.cfg'

